# ==============================================================================
# Yogneet Edu (Tech Geek Adarsh) — Public Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to configure your local Supabase instance.
#
# SECURITY NOTICE:
# - ONLY public/anon publishable keys belong in client-side Vite configurations.
# - NEVER put Supabase service_role keys, database passwords, or private secrets here.
# - If these variables are left unset, Yogneet Edu safely defaults to "local-mock" mode
#   for distraction-free prototyping and RBAC simulation.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable API Key (safe for browser distribution)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
